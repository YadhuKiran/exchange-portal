{
    "name": "exchange-portal/app",
    "description": "Global Student Mobility & Exchange Portal",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "phpmailer/phpmailer": "^6.9"


        
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
